Install the release and deploy workflows (ADR-0008).

Apply from the repository root after reviewing docs/ci/release.yml and docs/ci/deploy.yml,
which this patch reproduces byte for byte:

    git apply --check docs/ci/install-workflows.patch
    git apply docs/ci/install-workflows.patch
    cmp docs/ci/release.yml .github/workflows/release.yml
    cmp docs/ci/deploy.yml .github/workflows/deploy.yml

Both workflows stay inert while release/npm.json has "enabled": false.

diff --git a/.github/workflows/release.yml b/.github/workflows/release.yml
new file mode 100644
index 0000000..ed20511
--- /dev/null
+++ b/.github/workflows/release.yml
@@ -0,0 +1,165 @@
+# Release: seal a version of the activated npm package on push to main (ADR-0008).
+#
+#   gate      (contents: read)        release/npm.json must enable a valid package, else stop
+#   build     (contents: read)        npm ci --ignore-scripts, bundle, version, pack; record sha256
+#   sign      (id-token: write)       verify handoff digest; SHA256SUMS; cosign sign + attest
+#   release   (contents: write)       verify handoff + bundles; draft; upload; read back; publish
+#   dispatch  (actions: write)        gh workflow run deploy.yml at the new tag
+#
+# Each job gets only the authority its step needs: the job that runs third-party build code
+# can neither sign, write the repository, nor publish. The tarball is built once and its
+# sha256 is checked at every handoff.
+name: release
+
+on:
+  push:
+    branches: [main]
+
+permissions: {}
+
+concurrency:
+  group: release
+  cancel-in-progress: false
+
+jobs:
+  gate:
+    runs-on: ubuntu-24.04
+    permissions:
+      contents: read
+    outputs:
+      enabled: ${{ steps.gate.outputs.enabled }}
+      directory: ${{ steps.gate.outputs.directory }}
+      entry: ${{ steps.gate.outputs.entry }}
+      out-file: ${{ steps.gate.outputs.out-file }}
+      max-bundle-bytes: ${{ steps.gate.outputs.max-bundle-bytes }}
+    steps:
+      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1
+        with:
+          persist-credentials: false
+      - id: gate
+        uses: ./actions/release-gate
+
+  build:
+    needs: gate
+    if: needs.gate.outputs.enabled == 'true'
+    runs-on: ubuntu-24.04
+    permissions:
+      contents: read
+    outputs:
+      version: ${{ steps.build.outputs.version }}
+      tag: ${{ steps.build.outputs.tag }}
+      tarball: ${{ steps.digest.outputs.name }}
+      sha256: ${{ steps.digest.outputs.sha256 }}
+    steps:
+      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1
+        with:
+          fetch-depth: 0        # versioning reads commits since the last v* tag
+          persist-credentials: false
+      - id: build
+        uses: ./actions/npm-build
+        with:
+          working-directory: ${{ needs.gate.outputs.directory }}
+          entry: ${{ needs.gate.outputs.entry }}
+          out-file: ${{ needs.gate.outputs.out-file }}
+          max-bundle-bytes: ${{ needs.gate.outputs.max-bundle-bytes }}
+      - id: digest
+        if: steps.build.outputs.version != ''
+        env:
+          TARBALL: ${{ steps.build.outputs.tarball }}
+        run: |
+          echo "name=$(basename "$TARBALL")" >> "$GITHUB_OUTPUT"
+          echo "sha256=$(sha256sum "$TARBALL" | cut -d' ' -f1)" >> "$GITHUB_OUTPUT"
+      - if: steps.build.outputs.version != ''
+        uses: actions/upload-artifact@cf430e030ddbb5b0abf93d22962f4752f3646cd9 # v7.0.2
+        with:
+          name: npm-tarball
+          path: ${{ steps.build.outputs.tarball }}
+          if-no-files-found: error
+          retention-days: 7
+
+  sign:
+    needs: build
+    if: needs.build.outputs.version != ''
+    runs-on: ubuntu-24.04
+    permissions:
+      contents: read
+      id-token: write           # cosign keyless signing; nothing else
+    steps:
+      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1
+        with:
+          persist-credentials: false
+      - uses: actions/download-artifact@9000827ccba6bdab643e8b6fd33ac0654aef8333 # v8.0.2
+        with:
+          name: npm-tarball
+          path: ${{ runner.temp }}/sealed
+      - uses: ./actions/artifact-check
+        with:
+          dir: ${{ runner.temp }}/sealed
+          tarball: ${{ needs.build.outputs.tarball }}
+          sha256: ${{ needs.build.outputs.sha256 }}
+      - uses: ./actions/cosign-attest
+        with:
+          subjects: ${{ runner.temp }}/sealed/${{ needs.build.outputs.tarball }}
+          checksums-file: ${{ runner.temp }}/sealed/SHA256SUMS
+      - uses: actions/upload-artifact@cf430e030ddbb5b0abf93d22962f4752f3646cd9 # v7.0.2
+        with:
+          name: npm-sealed
+          path: ${{ runner.temp }}/sealed/
+          if-no-files-found: error
+          retention-days: 7
+
+  release:
+    needs: [build, sign]
+    runs-on: ubuntu-24.04
+    permissions:
+      contents: write           # draft, upload, publish the release; nothing else
+    outputs:
+      url: ${{ steps.publish.outputs.url }}
+    steps:
+      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1
+        with:
+          persist-credentials: false
+      - uses: actions/download-artifact@9000827ccba6bdab643e8b6fd33ac0654aef8333 # v8.0.2
+        with:
+          name: npm-sealed
+          path: ${{ runner.temp }}/sealed
+      - id: check
+        uses: ./actions/artifact-check
+        with:
+          dir: ${{ runner.temp }}/sealed
+          tarball: ${{ needs.build.outputs.tarball }}
+          sha256: ${{ needs.build.outputs.sha256 }}
+          signed: "true"
+      # Nothing becomes public unless its bundles verify against this workflow's identity.
+      - uses: ./actions/cosign-attest
+        with:
+          verify-only: "true"
+          subjects: |
+            ${{ runner.temp }}/sealed/${{ needs.build.outputs.tarball }}
+            ${{ runner.temp }}/sealed/SHA256SUMS
+      - id: draft
+        uses: ./actions/sealed-release
+        with:
+          phase: draft
+          tag: ${{ needs.build.outputs.tag }}
+      - id: publish
+        uses: ./actions/sealed-release
+        with:
+          phase: publish
+          tag: ${{ needs.build.outputs.tag }}
+          release-id: ${{ steps.draft.outputs.release-id }}
+          files: ${{ steps.check.outputs.files }}
+
+  dispatch:
+    needs: [build, release]
+    runs-on: ubuntu-24.04
+    permissions:
+      actions: write            # start deploy.yml; nothing else
+    steps:
+      - name: Deploy the sealed release to npm
+        env:
+          GH_TOKEN: ${{ github.token }}
+          GH_REPO: ${{ github.repository }}
+          TAG: ${{ needs.build.outputs.tag }}
+        # workflow_dispatch is one of the two events a GITHUB_TOKEN may trigger.
+        run: gh workflow run deploy.yml --ref "$TAG" -f tag="$TAG"
diff --git a/.github/workflows/deploy.yml b/.github/workflows/deploy.yml
new file mode 100644
index 0000000..1eee7bd
--- /dev/null
+++ b/.github/workflows/deploy.yml
@@ -0,0 +1,50 @@
+# Deploy: publish a sealed release to npm (ADR-0008). Dispatched by release.yml at the
+# release tag. To retry: gh workflow run deploy.yml --ref vX.Y.Z -f tag=vX.Y.Z
+#
+# Refuses unless release/npm.json at the tag enables the package, the run is a dispatch at
+# refs/tags/<tag>, the published release and the tag both point at this commit, and the
+# release's SHA256SUMS, tarball signature and provenance verify against release.yml@main and
+# name this commit. Publishes those exact bytes through npm trusted publishing (OIDC) with
+# provenance and checks the registry's integrity equals them.
+#
+# One-time setup: npmjs.com trusted publisher for this repository, workflow deploy.yml,
+# environment npm; then disallow token publishing. The npm environment must allow tags v*;
+# add required reviewers for a human gate.
+name: deploy
+
+on:
+  workflow_dispatch:
+    inputs:
+      tag:
+        description: Release tag (v<major>.<minor>.<patch>); select the same tag as the ref
+        required: true
+        type: string
+
+permissions: {}
+
+concurrency:
+  group: deploy-npm
+  cancel-in-progress: false
+
+jobs:
+  npm:
+    runs-on: ubuntu-24.04
+    environment: npm
+    permissions:
+      contents: read            # read the release
+      id-token: write           # npm trusted publishing
+    steps:
+      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1
+        with:
+          persist-credentials: false   # action code and activation come from the tag
+      - id: gate
+        uses: ./actions/release-gate
+      - name: Require activation at this tag
+        if: steps.gate.outputs.enabled != 'true'
+        run: |
+          echo "::error title=deploy::release/npm.json at this tag does not enable an npm package"
+          exit 1
+      - uses: ./actions/npm-trusted-publish
+        with:
+          tag: ${{ inputs.tag }}
+          package-name: ${{ steps.gate.outputs.name }}
